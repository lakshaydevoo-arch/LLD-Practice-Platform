PORT=3001
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# ==============================================================================
# EVALUATION PROVIDER SELECTION
# Options: 'MOCK', 'OPENAI', or 'GEMINI'
# - If set to 'MOCK' (or if keys are left blank), the platform uses the built-in
#   domain-aware heuristic evaluator (no API key needed, zero-failure).
# - If set to 'OPENAI', supply OPENAI_API_KEY below.
# - If set to 'GEMINI', supply GEMINI_API_KEY below.
# ==============================================================================
EVALUATION_PROVIDER=MOCK

# --- OpenAI Configuration ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
